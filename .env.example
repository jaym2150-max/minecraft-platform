# ──────────────────────────────────────────────
# Minecraft Platform — Environment Variables
# ──────────────────────────────────────────────

# ── App ──
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3003
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ── Authentication (MUST be changed in production) ──
JWT_SECRET=generate-a-secure-random-string-here
JWT_EXPIRATION=15m
# REQUIRED in production (>= 32 chars). MUST differ from JWT_SECRET so a leaked
# access-token secret cannot mint long-lived refresh tokens. Dev falls back to
# JWT_SECRET when unset, but production env validation rejects this.
JWT_REFRESH_SECRET=generate-a-separate-refresh-secret
REFRESH_TOKEN_EXPIRATION=7d

# ── OAuth ──
# The OAuth consent-code flow issues a single-use, SHA-256-hashed code that
# the callback page exchanges at POST /api/v1/auth/oauth/exchange. Set
# OAUTH_USE_CONSENT_CODE=false to opt OUT (legacy cookie-only redirect) — the
# legacy ?token=&user= URL parser is fully removed.
OAUTH_USE_CONSENT_CODE=true
# Lifetime of each consent code in seconds (clamped to 15..300, default 60).
OAUTH_CONSENT_CODE_TTL_SECONDS=60

# OAuth provider credentials (optional — only enable providers you register)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Two-Factor Authentication Encryption ──
# REQUIRED in production (>= 16 chars). Used to encrypt TOTP secrets at rest.
TFA_ENC_KEY=generate-a-separate-tfa-encryption-key

# ── CSRF Protection ──
# REQUIRED in production (>= 32 chars). Must NOT equal JWT_SECRET — the CSRF
# secret and the JWT signing secret must be independent values. The API refuses
# to boot in production without a secure, unique CSRF_SECRET.
CSRF_SECRET=generate-a-separate-csrf-secret

# ── Database ──
DATABASE_URL=postgresql://mcp:mcp@localhost:5432/minecraft_platform
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp
POSTGRES_DB=minecraft_platform

# ── Redis ──
# Note: the host port matches docker-compose.yml ("6379:6379"). Keep these in
# sync — a mismatch here makes the API / workers connect to the wrong port.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REQUIRED for `docker compose up` — Redis is started with `--requirepass`
# and rejects unauthenticated connections. The API and every worker read this
# env. Generate any reasonably long random value (no placeholder length
# constraint; the prod validator does not currently gate REDIS_PASSWORD, but
# `docker compose` fails fast if it is missing).
REDIS_PASSWORD=change-me-redis-password

# ── Meilisearch ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=generate-a-secure-key-here

# ── S3/MinIO Storage (MUST be changed in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=generate-a-secure-access-key
S3_SECRET_KEY=generate-a-secure-secret-key
S3_BUCKET=uploads
S3_PUBLIC_BUCKET=public

# ── ClamAV ──
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Email ──
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@minecraftplatform.com

# ── Rate Limiting ──
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60

# ── Next.js Public ──
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3003
# Public Discord invite — footer shows Discord link only when set (see apps/web/app/page.tsx)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/minecraftplatform

# ── Logging ──
LOG_LEVEL=debug
LOG_FORMAT=pretty
SESSION_TTL_SECONDS=86400

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
build/
.out/

# Environment
# Catch any .env-like file anywhere in the tree, regardless of where it lives
# or what its name is (`.env`, `.env.backup`, the malformed
# `CUsersSEDesktopminecraftsite.env`, etc.). Verbatim `.env` rules miss most
# variants, so we wildcard broadly and re-allow the template.
.env
.env.*
!.env.example
*/.env
*/.env.*
*.env
!/.env.example
docker/minio/minio.env
docker/meilisearch/meilisearch.toml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.dev.err
logs/
npm-debug.log*
api.log
dev.log
api.err
apps/api/api.err
apps/api/api.log

# Testing
coverage/
.nyc_output/

# Turborepo
.turbo/

# TypeScript build info
*.tsbuildinfo

# Claude Code agent worktrees (full repo duplicates)
.claude/worktrees/

# Prisma
# NOTE: migrations are intentionally NOT ignored. They must be committed so
# every environment applies the same schema history. Only the generated client
# and local SQLite scratch DBs are ignored below.

# Uploads
apps/api/uploads/

# Docker
docker/data/

# Temp
tmp/
temp/

# Backup files
*_backup.*
*_backup_*
*_checked.*
*_original.*
package_backup.json
package_checked.json
package_original.json
# Catch the more common `<file>.backup`, `<file>.backup2`, `<file>.bak`
# extension conventions used by editor scratch / pre-edit snapshots.
*.backup
*.backup.*
*.bak
*.bak.*

# Dev artifacts
apps/api/test*.txt
apps/api/test*.json
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Local override / scratch files
.env.override
.env.bak
.env.local.bak

# Infrastructure (rendered from templates)
infrastructure/kubernetes/01-secrets.yaml
infrastructure/cloudflare/.dev.vars

# Temp/scratchnotes
todo.md
prompt.md
directorytree.md
check_db.php

# Stale compiled JS shadowing TypeScript sources (build output, never source)
apps/api/src/**/*.js

apiVersion: v1
kind: Secret
metadata:
  name: mcp-secrets
  namespace: minecraft-platform
type: Opaque
stringData:
  # Generate with: openssl rand -hex 32
  # NOTE: copy this file to 01-secrets.yaml and substitute real values; the
  # generated file MUST NOT be committed.
  jwt-secret: "REPLACE_ME_WITH_RANDOM_64_CHAR_STRING"
  csrf-secret: "REPLACE_ME_WITH_DISTINCT_RANDOM_64_CHAR_STRING"
  tfa-enc-key: "REPLACE_ME_WITH_RANDOM_16_AND_RUN_SCrypt_KDF"
  session-ttl-seconds: "86400"
  database-url: "postgresql://mcp:STRONG_PASSWORD@postgres:5432/minecraft_platform"
  redis-url: "redis://redis:6379"
  meilisearch-api-key: "STRONG_MASTER_KEY"
  s3-access-key: "STRONG_ACCESS_KEY"
  s3-secret-key: "STRONG_SECRET_KEY"
  smtp-user: "apikey"
  smtp-pass: "REPLACE_WITH_SENDGRID_KEY"
  meilisearch-url: "http://meilisearch:7700"
  s3-endpoint: "http://minio:9000"
  s3-region: "us-east-1"
  s3-bucket: "uploads"
  s3-public-bucket: "public"
  smtp-host: "smtp.sendgrid.net"
  smtp-port: "587"
  smtp-from: "noreply@minecraftplatform.com"
  api-url: "https://api.minecraftplatform.com"
  web-url: "https://minecraftplatform.com"
  admin-url: "https://admin.minecraftplatform.com"
  github-client-id: "REPLACE_ME"
  github-client-secret: "REPLACE_ME"
  discord-client-id: "REPLACE_ME"
  discord-client-secret: "REPLACE_ME"
  stripe-secret-key: "REPLACE_ME"
  stripe-webhook-secret: "REPLACE_ME"
  clamav-host: "clamav"
  clamav-port: "3310"

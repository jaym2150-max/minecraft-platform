{
  "name": "minecraft-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A production-grade Minecraft mod hosting platform monorepo",
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9.x"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "db:generate": "pnpm --filter @mcp/api db:generate",
    "db:push": "pnpm --filter @mcp/api db:push",
    "db:migrate": "pnpm --filter @mcp/api db:migrate",
    "db:seed": "pnpm --filter @mcp/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "scan:dev": "pnpm --filter @mcp/virus-scanner dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@>=0.2.0 <1.9.0": ">=1.9.0",
      "tmp@<0.2.6": ">=0.2.6",
      "nodemailer@<=9.0.0": ">=9.0.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "webpack@<5.104.1": ">=5.104.1",
      "multer@<2.2.0": ">=2.2.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "file-type@<21.3.2": ">=21.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "lodash@<4.18.0": ">=4.18.0",
      "postcss@<8.5.10": ">=8.5.10",
      "@nestjs/core@>=11.0.0 <=11.1.17": ">=11.1.18",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@<8.0.16": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "undici@<7.28.0": ">=7.28.0",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <2.2.0",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6 <9.1.0",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5 <7.1.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}

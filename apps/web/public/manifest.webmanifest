{
  "name": "Minecraft Platform",
  "short_name": "MP",
  "description": "Discover, download and share Minecraft mods, modpacks and plugins — malware-scanned, every loader, every version.",
  "start_url": "/?utm_source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",

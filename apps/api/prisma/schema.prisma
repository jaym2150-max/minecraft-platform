generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  OWNER
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum VersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum LoaderType {
  FABRIC
  FORGE
  NEOFORGE
  QUILT
  BUKKIT
  SPIGOT
  PAPER
  PURPUR
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ProjectType {
  MOD
  MODPACK
  RESOURCE_PACK
  SHADER
  DATA_PACK
  PLUGIN
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

enum TeamRole {
  OWNER
  ADMIN
  DEVELOPER
  CONTRIBUTOR
}

enum NotificationType {
  PROJECT_UPDATE
  VERSION_RELEASE
  REVIEW
  COMMENT
  FOLLOW
  TEAM_INVITE
  MODERATION
  PAYOUT
  SYSTEM
}

enum ThreadType {
  PROJECT_REPORT
  USER_REPORT
  VERSION_REPORT
  MODERATION
  DMCA
  APPEAL
  DIRECT_MESSAGE
  TEAM_INVITE
}

enum LicenseType {
  PERMISSIVE
  COPYLEFT
  PROPRIETARY
  PUBLIC_DOMAIN
  UNKNOWN
}

enum ApiKeyScope {
  READ
  WRITE
  DELETE
  USER_READ
  USER_WRITE
  PROJECT_READ
  PROJECT_WRITE
  VERSION_READ
  VERSION_WRITE
  ANALYTICS_READ
  ADMIN
}

enum CreatorTier {
  FREE
  CREATOR
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum RateLimitTier {
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  displayName    String?
  email          String    @unique
  emailVerified  Boolean   @default(false)
  passwordHash   String
  avatarUrl      String?
  bio            String?
  role           UserRole  @default(USER)
  creatorTier    CreatorTier @default(FREE)
  banned         Boolean   @default(false)
  bannedReason   String?
  stripeCustomerId String?
  githubId       String?
  discordId      String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  projects       Project[]
  comments       Comment[]
  reviews        Review[]
  follows        Follow[]
  notifications  Notification[]
  teamMembers    TeamMember[]
  reports Report[] @relation("ReportedUser")
  reportsMade Report[] @relation("Reporter")
  sessions Session[]
  oauthConsentCodes OAuthConsentCode[]
  twoFactorSecret TwoFactorSecret?
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  apiKeys ApiKey[]
  collections Collection[]
  threadMessages ThreadMessage[]
  threadParticipants ThreadParticipant[]
  reportedInThreads Thread[] @relation("ThreadSubject")
  initiatedThreads Thread[] @relation("ThreadInitiator")
  donationsMade    Donation[] @relation("DonatedBy")
  donationsReceived Donation[] @relation("DonatedTo")
  earningLedger    EarningLedger[]
  payouts          Payout[]
  payoutAccount    PayoutAccount?
  subscription     Subscription?
  followers        UserFollow[] @relation("Follower")
  following        UserFollow[] @relation("Followed")
  guides           Guide[]
  permissionOverrides UserPermissionOverride[]

  @@map("users")
}

model Project {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  description    String
  body           String?
  iconUrl        String?
  coverUrl       String?
  sourceUrl      String?
  discordUrl     String?
  wikiUrl        String?
  downloads      Int           @default(0)
  views          Int           @default(0)
  promotedUntil  DateTime?
  /** Cached 0-100 compatibility score (loader/version match + deps resolved).
   *  Null = not yet computed. Updated by the modpack resolver. */
  compatibilityScore  Float?
  status         ProjectStatus @default(DRAFT)
  featured       Boolean       @default(false)
  clientSide     Boolean       @default(true)
  serverSide     Boolean       @default(true)
  projectType    ProjectType   @default(MOD)
  authorId       String
  categoryId     String?
  licenseId      String?
  ratingAverage  Float?        @default(0)
  ratingCount    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  author         User              @relation(fields: [authorId], references: [id])
  category       Category?         @relation(fields: [categoryId], references: [id])
  license        License?          @relation(fields: [licenseId], references: [id])
  versions       ProjectVersion[]
  dependencies   Dependency[]     @relation("DependentProject")
  dependenciesBy Dependency[]     @relation("RequiredProject")
  comments       Comment[]
  teamMembers    TeamMember[]
  loaders        Loader[]
  teams          Team[]       @relation("ProjectTeams")
  reviews        Review[]
  follows        Follow[]

  notifications  Notification[]
  collectionProjects CollectionProject[]
  galleryImages GalleryImage[]
  donations      Donation[]
  promotion      PromotedProject?
  providerProjects ProviderProject[]
  tags         ProjectTag[]

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([projectType, status])
  @@index([licenseId])
  @@map("projects")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  title     String?
  body      String?
  userId    String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("reviews")
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  keyHash   String    @unique
  lastChars String
  userId    String
  scopes    ApiKeyScope[] @default([READ])
  ipAllowlist String[] @default([])
  rateLimitTier RateLimitTier @default(BASIC)
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  isPublic    Boolean  @default(true)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects CollectionProject[]

  @@index([userId])
  @@index([isPublic])
  @@map("collections")
}

model CollectionProject {
  id           String   @id @default(uuid())
  collectionId String
  projectId    String
  notes        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([collectionId, projectId])
  @@index([collectionId])
  @@index([projectId])
  @@map("collection_projects")
}

model GalleryImage {
  id          String          @id @default(uuid())
  type        GalleryItemType @default(IMAGE)
  url         String
  thumbnailUrl String?
  alt         String?
  width       Int?
  height      Int?
  order       Int             @default(0)
  projectId   String
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, order])
  @@map("gallery_images")
}

model ProjectVersion {
  id          String        @id @default(uuid())
  version     String
  externalId  String?
  changelog   String?
  fileUrl     String
  fileSize    Int
  hash        String
  hashSha1    String?
  hashSha512  String?
  filename    String?
  downloads   Int           @default(0)
  status      VersionStatus @default(DRAFT)
  scanStatus  ScanStatus?   @default(PENDING)
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  project      Project            @relation(fields: [projectId], references: [id])
  dependencies Dependency[]
  loaders      Loader[]

  @@unique([projectId, version])
  @@unique([projectId, externalId])
  @@index([projectId])
  @@index([status])
  @@index([hash])
  @@index([hashSha1])
  @@index([hashSha512])
  @@map("project_versions")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  projects    Project[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  projects    ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  id        String   @id @default(uuid())
  projectId String
  tagId     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

model Loader {
  id        String   @id @default(uuid())
  type      LoaderType
  versionString   String?
  projectId String
  versionId String
  createdAt DateTime @default(now())

  project   Project         @relation(fields: [projectId], references: [id])
  version   ProjectVersion  @relation(fields: [versionId], references: [id])

  @@index([projectId])
  @@index([versionId])
  @@index([type])
  @@index([versionString])
  @@index([type, versionString])
  @@map("loaders")
}

model MinecraftVersion {
  id      String @id @default(uuid())
  version String @unique
  type    String @default("release")
  stable  Boolean @default(true)

  @@map("minecraft_versions")
}

model Dependency {
  id           String @id @default(uuid())
  dependentId  String
  requiredId   String
  versionId    String
  isRequired     Boolean @default(true)
  isOptional     Boolean @default(false)
  /** Constraint kind: REQUIRED | OPTIONAL | INCOMPATIBLE. Preferred over the
   *  legacy isRequired/isOptional booleans for resolver semantics. */
  kind         String         @default("REQUIRED")
  /** Semver range the resolved version string must satisfy, e.g.
   *  ">=1.2.0 <2.0.0". Null = any version. */
  versionRange String?
  /** Loader the dependency requires; null = any loader. */
  loaderType   LoaderType?
  createdAt    DateTime @default(now())

  dependent    Project         @relation("DependentProject", fields: [dependentId], references: [id])
  required     Project         @relation("RequiredProject", fields: [requiredId], references: [id])
  version      ProjectVersion  @relation(fields: [versionId], references: [id])

  @@index([dependentId])
  @@index([requiredId])
  @@map("dependencies")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  authorId String
  projectId String
  parentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")

  @@index([projectId])
  @@index([authorId])
  @@map("comments")
}

model Follow {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("follows")
}

model UserFollow {
  id        String   @id @default(uuid())
  followerId String
  followedId String
  createdAt DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id])
  followed User @relation("Followed", fields: [followedId], references: [id])

  @@unique([followerId, followedId])
  @@index([followerId])
  @@index([followedId])
  @@map("user_follows")
}

model Notification {
  id        String   @id @default(uuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  userId    String
  projectId String?
  createdAt DateTime @default(now())

  user           User    @relation(fields: [userId], references: [id])
  project        Project? @relation(fields: [projectId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project      @relation("ProjectTeams", fields: [projectId], references: [id])
  members     TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  role      TeamRole @default(CONTRIBUTOR)
  userId    String
  teamId    String
  projectId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, teamId])
  @@map("team_members")
}

model Download {
  id        String   @id @default(uuid())
  projectId String
  versionId String
  userId    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([versionId])
  @@index([createdAt])
  @@map("downloads")
}

model Report {
  id String @id @default(uuid())
  reason String
  description String?
  status ReportStatus @default(PENDING)
  reporterId String
  reportedId String
  projectId String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  reported User @relation("ReportedUser", fields: [reportedId], references: [id])

  @@index([status])
  @@map("reports")
}

model Session {
  id String @id @default(uuid())
  userId String
  // Hash of the access-token jti. Used by JwtStrategy to confirm the session
  // backing an incoming JWT still exists (revocation + expiry enforcement).
  tokenHash String @unique
  // Hash of the refresh-token jti. A session owns exactly one refresh token at
  // a time; rotation replaces this hash while keeping the same Session row so
  // logout / revoke / ban can kill both tokens by deleting the row.
  refreshTokenHash String?
  // Hash of the PREVIOUS refresh-token jti, kept for exactly one rotation
  // window so a replayed (stolen-then-rotated) refresh token is detectable:
  // if a presented hash matches this, the legitimate user already rotated
  // past it, so the presented token is a replay. We then revoke the entire
  // session family (all of that user's sessions) — the standard refresh-
  // token-theft recovery. Cleared at the same time as refreshTokenHash moves
  // to its next value, so only one prior hash is retained per session.
  previousRefreshTokenHash String?
  device String?
  browser String?
  os String?
  ip String?
  lastActiveAt DateTime @default(now())
  // Access-token session expiry — drives JwtStrategy's session check.
  expiresAt DateTime
  // Refresh-token lifetime. The session can mint a new access token only while
  // this is still in the future; after it lapses the user must re-authenticate.
  refreshExpiresAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

/// Short-lived, single-use authorization code issued by the OAuth callback
/// and exchanged by the web app for a Set-Cookie + opaque user payload via
/// POST /auth/oauth/exchange. The code-swap pattern keeps the JWT out of the
/// URL/referrer/logs.
model OAuthConsentCode {
  id         String   @id @default(uuid())
  codeHash   String   @unique
  userId     String
  callbackUrl String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_consent_codes")
}

model TwoFactorSecret {
  id String @id @default(uuid())
  userId String @unique
  secret String
  verified Boolean @default(false)
  backupCodes String[]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model SubscriptionPlan {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  tier      CreatorTier
  price     Int      // in cents
  interval  String   @default("month") // month | year
  description String?
  features  String[] // JSON array of feature descriptions
  popular   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  planId          String
  stripeSubscriptionId String?       @unique
  stripePriceId   String?
  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd   Boolean        @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Donation {
  id        String   @id @default(uuid())
  amount    Int      // in cents
  message   String?
  anonymous Boolean  @default(false)
  donorId   String
  recipientId String
  projectId String?
  stripePaymentIntentId String? @unique
  createdAt DateTime @default(now())

  donor     User     @relation("DonatedBy", fields: [donorId], references: [id])
  recipient User     @relation("DonatedTo", fields: [recipientId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([recipientId])
  @@index([donorId])
  @@index([createdAt])
  @@map("donations")
}

model PromotedProject {
  id        String   @id @default(uuid())
  projectId String   @unique
  startsAt  DateTime @default(now())
  endsAt    DateTime
  active    Boolean  @default(true)
  stripePaymentIntentId String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([active, endsAt])
  @@map("promoted_projects")
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  tokenPrefixHash String @unique
  expiresAt DateTime
  used Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([used, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  tokenPrefixHash String @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([used, expiresAt])
  @@map("email_verification_tokens")
}

model License {
  id          String      @id @default(uuid())
  shortId     String      @unique
  name        String
  type        LicenseType @default(UNKNOWN)
  url         String?
  description String?
  body        String?     @db.Text
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  projects Project[]

  @@index([type])
  @@map("licenses")
}

model Thread {
  id              String     @id @default(uuid())
  type            ThreadType
  subjectId       String?
  subjectType     String?
  initiatorId     String
  title           String
  status          String     @default("open")
  lastMessageAt   DateTime   @default(now())
  closedAt        DateTime?
  closedById      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  initiator  User              @relation("ThreadInitiator", fields: [initiatorId], references: [id])
  subject    User?             @relation("ThreadSubject", fields: [subjectId], references: [id], map: "Thread_subjectId_fkey")
  messages   ThreadMessage[]
  participants ThreadParticipant[]

  @@index([type, status])
  @@index([subjectId, subjectType])
  @@index([lastMessageAt])
  @@map("threads")
}

model ThreadParticipant {
  id           String   @id @default(uuid())
  threadId     String
  userId       String
  joinedAt     DateTime @default(now())
  lastReadAt   DateTime?
  role         String   @default("participant")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model ThreadMessage {
  id        String   @id @default(uuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([threadId, createdAt])
  @@map("thread_messages")
}
// -------------------------------------------------------------
// Creator earnings & payouts
// -------------------------------------------------------------

/// Per-download credit accrual. One row per credited download event
/// (written by the analytics pipeline, idempotent on (userId, downloadId)).
model EarningLedger {
  id           String   @id @default(uuid())
  userId       String
  amountPoints Int
  projectId    String?
  downloadId   String?  @unique
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("earning_ledger")
}

/// A withdrawal request / transfer to the creator's Stripe account.
model Payout {
  id              String      @id @default(uuid())
  userId          String
  amountCents     Int
  status          String      @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  stripeTransferId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payouts")
}

/// One Stripe Express account per user (created lazily on first payout setup).
model PayoutAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  stripeAccountId String
  payoutsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

/// Newsletter subscriber (weekly digest opt-in).
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("homepage")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

enum ProviderLinkStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum SyncJobType {
  FULL_IMPORT
  INCREMENTAL
  STATS_REFRESH
  SINGLE_PROJECT
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
}

enum SyncLogLevel {
  INFO
  WARN
  ERROR
}

/// External content provider (Modrinth, later CurseForge).
model Provider {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  baseUrl   String
  apiUrl    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProviderProject[]
  syncJobs SyncJob[]

  @@map("providers")
}

/// Link between an internal project and its external provider project.
/// A single internal project may have one row per provider.
model ProviderProject {
  id                String             @id @default(uuid())
  providerId        String
  projectId         String
  externalId        String
  externalSlug      String
  externalUrl       String
  status            ProviderLinkStatus @default(ACTIVE)
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([providerId, projectId])
  @@unique([providerId, externalId])
  @@index([providerId, lastSyncedAt])
  @@map("provider_projects")
}

/// Granular permission key (e.g. "project.publish", "user.ban").
/// Defined globally; mapped to roles via `RolePermission` rows.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions   RolePermission[]
  userOverrides     UserPermissionOverride[]

  @@map("permissions")
}

/// Default permission grants for a role. `granted=true` adds the permission;
/// `granted=false` explicitly removes it (overrides any broader default).
model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Per-user override. `granted=true` adds the permission, `granted=false`
/// revokes it even if the role default includes it.
model UserPermissionOverride {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  reason       String?
  createdBy    String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permission_overrides")
}

/// One provider synchronization run (full import, incremental, stats, single).
model SyncJob {
  id             String        @id @default(uuid())
  providerId     String
  type           SyncJobType
  status         SyncJobStatus @default(PENDING)
  trigger        SyncTrigger   @default(MANUAL)
  processedCount Int           @default(0)
  createdCount   Int           @default(0)
  updatedCount   Int           @default(0)
  errorCount     Int           @default(0)
  message        String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  provider Provider  @relation(fields: [providerId], references: [id])
  logs     SyncLog[]

  @@index([providerId, createdAt])
  @@index([status, createdAt])
  @@map("sync_jobs")
}

/// Structured log lines for a sync run (admin-visible sync diagnostics).
model SyncLog {
  id        String       @id @default(uuid())
  syncJobId String
  level     SyncLogLevel @default(INFO)
  message   String
  detail    String?
  createdAt DateTime     @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, createdAt])
  @@map("sync_logs")
}

enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Guide {
  id        String      @id @default(uuid())
  slug      String      @unique
  title     String
  excerpt   String?
  body      String?
  coverUrl  String?
  category  String?
  authorId  String?
  status    GuideStatus @default(DRAFT)
  views     Int         @default(0)
  featured  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author User? @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("guides")
}

/// Per-loader install guide template. The `body` is a markdown string with
/// `{{projectName}}`, `{{loader}}`, `{{loaderVersion}}`, `{{gameVersion}}` and
/// `{{client}}`/`{{server}}` placeholders that the renderer substitutes. The
/// `recommended` column shows the template on the project page by default.
model InstallGuideTemplate {
  id        String   @id @default(uuid())
  loader    String
  title     String
  excerpt   String?
  body      String
  recommended Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loader])
  @@index([recommended])
  @@map("install_guide_templates")
}
